{
  "commands": {
    "homingSequence": {
      "type": "homingSequence",
      "description": "Perform homing sequence for specified axis",
      "parameters": {
        "axis": {
          "type": "number",
          "description": "Axis number (0-5)",
          "min": 0,
          "max": 5,
          "required": true
        }
      }
    },
    "setAxisAngle": {
      "type": "setAxisAngle",
      "description": "Set angle for specific axis",
      "parameters": {
        "axis": {
          "type": "number",
          "description": "Axis number (0-5)",
          "min": 0,
          "max": 5,
          "required": true
        },
        "angle": {
          "type": "number",
          "description": "Target angle in degrees",
          "min": -180,
          "max": 180,
          "required": true
        }
      }
    },
    "getState": {
      "type": "getState",
      "description": "Get current state of all axes"
    },
    "emergencyStop": {
      "type": "emergencyStop",
      "description": "Emergency stop - halt all movement"
    },
    "setArmState": {
      "type": "setArmState",
      "description": "Set complete arm state",
      "parameters": {
        "state": {
          "type": "object",
          "description": "Complete arm state object",
          "required": true
        }
      }
    },
    "runTest": {
      "type": "runTest",
      "description": "Run predefined test sequence",
      "parameters": {
